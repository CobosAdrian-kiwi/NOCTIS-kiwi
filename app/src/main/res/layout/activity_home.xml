<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/noctis_fondo">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/noctis_texto"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="@string/lema"
        android:textColor="@color/noctis_texto"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnMiNoche"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_mi_noche" />

    <Button
        android:id="@+id/btnAdaptacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_adaptacion" />

    <Button
        android:id="@+id/btnAcerca"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_acerca" />




</LinearLayout>